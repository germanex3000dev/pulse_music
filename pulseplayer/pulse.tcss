/* PULSE theme - all colors come from ~/.config/pulseplayer/config.toml
   (see config.py for the defaults). Do not hardcode colors here;
   reference the $pulse-* variables instead. */

Screen {
    background: $pulse-background;
    color: $pulse-text;
    layout: vertical;
}

Header {
    background: $pulse-background;
    color: $pulse-title;
    text-style: bold;
    height: 1;
}

Header > .header--title {
    color: $pulse-title;
    text-style: bold;
    text-align: left;
    padding-left: 1;
}

Header > .header--subtitle {
    color: $pulse-subtitle;
    background: $pulse-background;
}

/* no glyph icon in the header - this is a terminal, not a desktop */
HeaderIcon {
    display: none;
}

/* ---- main row: library + now playing ---- */

#main-row {
    height: 1fr;
    width: 100%;
    overflow-x: hidden;
    scrollbar-size: 0 0;
}

#library-pane {
    width: 32%;
    height: 100%;
    background: $pulse-surface;
    display: block;
    overflow-x: hidden;
}

#library-pane.-hidden {
    display: none;
}

#lib-search {
    height: 3;
    background: $pulse-panel;
    border: none;
    padding: 0 1;
    color: $pulse-label;
}

#lib-search:focus {
    background: $pulse-highlight-bg;
    color: $pulse-focus-text;
}

#lib-search.-hidden {
    display: none;
}

#lib-title {
    background: $pulse-panel;
    color: $pulse-accent;
    text-style: bold;
    height: 3;
    content-align: center middle;
    text-align: center;
}

#lib-tree {
    background: $pulse-surface;
    color: $pulse-muted;
    height: 1fr;
    padding: 0 1;
    scrollbar-size: 1 0;
}

#lib-tree > .tree--guides {
    color: $pulse-dim;
}

#lib-tree > .tree--highlight {
    background: $pulse-highlight-bg;
    color: $pulse-focus-text;
}

#lib-tree > .tree--cursor {
    background: $pulse-cursor-bg;
    color: $pulse-focus-text;
}

#lib-tree > .tree--selected {
    background: $pulse-selected-bg;
    color: $pulse-focus-text;
}

#lib-tree > .tree--expander {
    color: $pulse-expander;
}

#lib-tree > .tree--label {
    color: $pulse-label;
}

#now-pane {
    width: 68%;
    height: 100%;
    background: $pulse-background;
    overflow-x: hidden;
}

/* library is hidden, so now-playing takes the whole row */
#now-pane.no-lib {
    width: 100%;
}

#now-title {
    color: $pulse-text;
    text-style: bold;
    height: 3;
    content-align: center middle;
    text-align: center;
    background: $pulse-background;
    width: 100%;
}

Visualizer {
    height: 1fr;
    width: 100%;
    color: $pulse-primary;
    background: $pulse-background;
    margin-top: 1;
    padding: 0 1;
}

Visualizer.-hidden {
    display: none;
}

/* with the visualizer hidden, let the track title own the whole pane */
#now-pane.no-viz #now-title {
    height: 1fr;
    content-align: center middle;
}

/* ---- header row: current track + time ---- */

#header-row {
    height: 3;
    width: 100%;
    background: $pulse-surface;
    padding: 0 1;
    align-vertical: middle;
}

.oneline {
    height: 1;
    content-align: left middle;
}

#bar-title {
    color: $pulse-subtitle;
    text-style: bold;
    width: 1fr;
}

#bar-time {
    color: $pulse-time;
    width: auto;
    content-align: right middle;
    margin-left: 1;
}

/* ---- keybind bar ---- */

#bindbar {
    height: 1;
    width: 100%;
    background: $pulse-background;
    layout: horizontal;
    padding: 0 1;
    align-vertical: middle;
}

#bindbar .bind-item {
    color: $pulse-muted;
    height: 1;
    width: auto;
    margin-right: 1;
    text-style: not bold;
}

/* ---- progress row: seek + volume ---- */

#progress-row {
    height: 3;
    width: 100%;
    background: $pulse-surface;
    padding: 0 1;
    align-vertical: middle;
}

#seek {
    height: 1;
    width: 1fr;
}

ProgressBar {
    background: $pulse-track;
    color: $pulse-progress;
}

ProgressBar > .progress--bar {
    background: $pulse-primary;
    color: $pulse-progress-text;
}

ProgressBar > .progress--remaining {
    background: $pulse-track;
}

#vol {
    color: $pulse-time;
    height: 1;
    content-align: right middle;
    background: transparent;
    width: auto;
    margin-left: 1;
}

/* ---- scrollbar ---- */

Scrollbar {
    background: $pulse-track;
    color: $pulse-scrollbar;
}

Scrollbar > .scrollbar--bar {
    background: $pulse-scrollbar-track;
    color: $pulse-expander;
}

Scrollbar > .scrollbar--grabber {
    background: $pulse-scrollbar;
    color: $pulse-error;
}
